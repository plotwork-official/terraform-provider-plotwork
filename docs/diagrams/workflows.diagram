# Generated by plotwork generate from the source workflows (github-actions: .github/workflows/*.yml, .github/workflows/*.yaml).
# The next run writes over this file. Put changes in docs/diagrams/workflows.overrides.json, or run plotwork generate --capture
# after an edit to keep it there, then run plotwork generate.
flow "Release pipeline" direction=down desc="7 jobs and their steps of the Release pipeline workflow, started by a push to main or a manual run, in the order their needs set, imported from GitHub Actions."

node on terminal "Push or manual run"

group job_plan "What to release" type=ci-cd sub="ubuntu-latest" {
  node plan_1 step "Checkout" icon=simple:github
  node plan_2 step "scripts/next-version.sh | tee -a"
}

group job_tag_beta "Tag the beta" type=ci-cd sub="ubuntu-latest" {
  node tag_beta_1 step "Checkout" icon=simple:github
}

group job_release_beta "Release the beta" type=ci-cd sub="Calls release.yml" {
  node release_beta step "Release the beta" sub="Calls release.yml"
}

group job_smoke_preview "Smoke test on preview" type=ci-cd sub="Calls smoke.yml" {
  node smoke_preview step "Smoke test on preview" sub="Calls smoke.yml"
}

group job_tag_stable "Tag the stable version" type=ci-cd sub="ubuntu-latest" {
  node tag_stable_1 step "Checkout" icon=simple:github
}

group job_release_stable "Release the stable version" type=ci-cd sub="Calls release.yml" {
  node release_stable step "Release the stable version" sub="Calls release.yml"
}

group job_smoke_production "Smoke test on production" type=environment sub="Calls smoke.yml" {
  node smoke_production step "Smoke test on production" sub="Calls smoke.yml"
}

on -> plan_1
plan_1 -> plan_2
plan_2 -> tag_beta_1
plan_2 -> release_beta
tag_beta_1 -> release_beta
plan_2 -> smoke_preview
release_beta -> smoke_preview
plan_2 -> tag_stable_1
smoke_preview -> tag_stable_1
plan_2 -> release_stable
tag_stable_1 -> release_stable
plan_2 -> smoke_production
release_stable -> smoke_production
